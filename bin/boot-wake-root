#!/bin/bash

# The privileged half of Boot & Wake, run through pkexec. It touches the
# timeout line of /boot/limine.conf, keeping the original line so it can be
# put back exactly, and its own startup hook for the number pad.
#
#   boot-wake-root boot-menu-set <seconds>
#   boot-wake-root boot-menu-restore
#   boot-wake-root numpad-on | numpad-off

set -euo pipefail

# Tests run unprivileged against a fake tree. pkexec clears the environment,
# so this cannot redirect a real privileged run.
fake_root=${BW_TEST_ROOT:-}
# The ESP the Limine tools use, from their own config (default /boot).
esp=$(sed -n 's/^[[:space:]]*ESP_PATH[[:space:]]*=[[:space:]]*["\x27]\{0,1\}\([^"\x27]*\).*/\1/p' \
  "$fake_root/etc/default/limine" 2>/dev/null | tail -n1 || true)
conf=$fake_root${esp:-/boot}/limine.conf
state_dir=$fake_root/var/lib/boot-wake
saved=$state_dir/limine-timeout.orig
# The line we write; anything else on the timeout line is the user's own.
marker="# set by Boot & Wake"

backup=$conf.boot-wake.bak

[[ -n $fake_root ]] || (( EUID == 0 )) || { echo "boot-wake-root must run as root" >&2; exit 1; }

# A root snapshot first, so the machine can be rolled back from the boot
# menu's Snapshots entry. No snapshot, no change.
snapshot() {
  command -v snapper >/dev/null && snapper -c root get-config >/dev/null 2>&1 ||
    { echo "No Snapper root config, so no restore point can be made. Nothing changed." >&2; exit 1; }
  snapper -c root create --cleanup-algorithm number \
    --description "Boot & Wake: before $1" ||
    { echo "Snapshot failed. Nothing changed." >&2; exit 1; }
}

# Checks before limine.conf is edited. The number pad switch never edits it,
# so these apply to the boot menu only.
check_limine_conf() {
  [[ -f $conf ]] || { echo "No Limine config at $conf" >&2; exit 1; }

  # Secure Boot setups enrol a checksum of limine.conf; changing the file
  # without re-enrolling makes Limine refuse to boot. Not supported.
  if grep -qsE "^[[:space:]]*ENABLE_ENROLL_LIMINE_CONFIG[[:space:]]*=[[:space:]]*[\"']?yes" \
    "$fake_root/etc/limine-entry-tool.conf" "$fake_root/etc/default/limine" \
    "$fake_root"/etc/limine-entry-tool.d/*.conf; then
    echo "Limine config enrolment is on (Secure Boot); changing limine.conf would stop it booting. Nothing changed." >&2
    exit 1
  fi

  # With Secure Boot on, Limine may check an enrolled hash of its config even if
  # the setting above is off (it can be enrolled by hand). Not supported either.
  secure_boot=$(ls "$fake_root"/sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | head -n1 || true)
  if [[ -n $secure_boot ]] && [[ $(od -An -tu1 "$secure_boot" 2>/dev/null | awk '{print $NF}') == 1 ]]; then
    echo "Secure Boot is on; changing limine.conf could stop it booting. Nothing changed." >&2
    exit 1
  fi
}

# limine-entry-tool and limine-snapper-sync rewrite limine.conf under this
# lock; holding it keeps their edits and ours from overwriting each other.
lock_boot_partition() {
  local lock=$fake_root/run/lock/boot-partition.lock
  mkdir -p "${lock%/*}"
  exec 200>"$lock"
  flock --timeout=60 200 || { echo "The boot partition is busy. Nothing changed." >&2; exit 1; }
}

# Writes the new config beside the old one, checks that only the timeout line
# differs, then swaps it in. Anything unexpected leaves the old file in place.
# The ESP is FAT with no journal, so flush the rename before reporting success.
replace_conf() {
  local tmp=$conf.boot-wake.tmp changed
  cat >"$tmp"
  changed=$(diff "$conf" "$tmp" | grep -E '^[<>]' | grep -vcE '^[<>][[:space:]]*#?[[:space:]]*timeout:' || true)
  if [[ $changed != 0 || ! -s $tmp ]]; then
    rm -f "$tmp"
    echo "Unexpected change to $conf; left it untouched." >&2
    exit 1
  fi
  sync "$tmp"
  mv "$tmp" "$conf"
  sync -f "$conf"
}

current_timeout_line() {
  grep -m1 -E '^[[:space:]]*#?[[:space:]]*timeout:' "$conf" || true
}

set_menu() {
  local seconds=$1 line
  [[ $seconds =~ ^[1-4](\.5)?$ ]] ||
    { echo "Seconds must be 1 to 4.5, in half seconds" >&2; exit 1; }
  check_limine_conf

  snapshot "shortening the boot menu to ${seconds}s"
  lock_boot_partition
  # The ESP is not in any Btrfs snapshot, so keep a copy of the config there.
  # Only the first copy is kept: the config as it was before Boot & Wake.
  if [[ ! -f $backup ]]; then
    cp -p "$conf" "$backup"
    sync -f "$backup"
  fi
  line=$(current_timeout_line)
  # Keep the original from the first change only; a repeat run must not save
  # our own line as the "original".
  if [[ ! -f $saved && $line != *"$marker"* ]]; then
    mkdir -p "$state_dir"
    printf '%s\n' "${line:-<none>}" >"$saved"
  fi

  if [[ -n $line ]]; then
    awk -v new="timeout: $seconds $marker" '
      !done && /^[[:space:]]*#?[[:space:]]*timeout:/ { print new; done = 1; next }
      { print }' "$conf" | replace_conf
  else
    # No timeout line at all: add one after the leading comment block.
    awk -v new="timeout: $seconds $marker" '
      !done && !/^#/ { print new; done = 1 }
      { print }
      END { if (!done) print new }' "$conf" | replace_conf
  fi
}

restore_menu() {
  local original
  check_limine_conf
  if [[ -f $saved ]]; then
    original=$(<"$saved")
  elif [[ -f $backup ]]; then
    # The saved line can be lost, e.g. by rolling root back to a snapshot
    # from before the change. The ESP backup still has the original.
    original=$(grep -m1 -E '^[[:space:]]*#?[[:space:]]*timeout:' "$backup" || echo "<none>")
  else
    original="<none>"
  fi
  if ! grep -qF "$marker" "$conf"; then
    echo "Boot menu already at its original setting" >&2
    rm -f "$saved" "$backup"
    exit 0
  fi

  snapshot "restoring the boot menu wait"
  lock_boot_partition
  if [[ $original == "<none>" ]]; then
    grep -v -F "$marker" "$conf" | replace_conf
  else
    awk -v orig="$original" -v mark="$marker" '
      index($0, mark) { print orig; next }
      { print }' "$conf" | replace_conf
  fi
  rm -f "$saved" "$backup"
  rmdir "$state_dir" 2>/dev/null || true
}

# The number pad. Plymouth draws the disk password screen and reads the
# keyboard itself, with Num Lock always starting off. A startup hook that runs
# just before Plymouth adds XKB's numpad:mac option ("the number pad always
# types digits") to the copy of vconsole.conf inside the startup image. The
# installed system's own vconsole.conf is never changed.
numpad_hook=$fake_root/etc/initcpio/hooks/boot-wake-numpad
numpad_install=$fake_root/etc/initcpio/install/boot-wake-numpad
numpad_conf=$fake_root/etc/mkinitcpio.conf.d/zz-boot-wake-numpad.conf

# HOOKS as mkinitcpio will see them, with spaces around every name.
initramfs_hooks() {
  # shellcheck disable=SC2016 # expanded by the inner shell
  bash -c 'HOOKS=()
    for f in "$1/etc/mkinitcpio.conf" "$1"/etc/mkinitcpio.conf.d/*.conf; do
      [[ -r $f ]] && source "$f" >/dev/null 2>&1
    done
    echo " ${HOOKS[*]} "' _ "$fake_root"
}

# The first XKB layout in vconsole.conf, which Plymouth needs to build its own
# keymap. Omarchy keeps the file out of the startup image for layouts that
# don't type Latin letters; the hook does nothing there, so those count as none.
vconsole_layout() {
  local layout
  layout=$(sed -n 's/^XKBLAYOUT=//p' "$fake_root/etc/vconsole.conf" 2>/dev/null | tail -n1 | sed "s/[\"']//g")
  layout=${layout%%,*}
  case $layout in
    af | am | ara | bd | bg | by | et | ge | gr | il | in | iq | ir | kg | kh | kz | la | lk | mk | mm | mn | mv | np | rs | ru | sy | th | tj | ua) ;;
    *) echo "$layout" ;;
  esac
}

write_numpad_files() {
  mkdir -p "${numpad_hook%/*}" "${numpad_install%/*}" "${numpad_conf%/*}"
  cat >"$numpad_hook" <<'EOF'
#!/usr/bin/ash
# Installed by the Boot & Wake Omarchy plugin; turn it off in its panel.
# Runs just before Plymouth starts, so the number pad types digits at the disk
# password screen. Changes only the copy of vconsole.conf in this startup image.

run_hook() {
    local conf="${BW_VCONSOLE:-/etc/vconsole.conf}" opts
    [ -f "$conf" ] || return 0
    opts=$(sed -n 's/^XKBOPTIONS=//p' "$conf" | tail -n1 | sed "s/[\"']//g")
    # Someone who picked a number pad behaviour keeps it.
    case ",$opts," in *,numpad:*) return 0 ;; esac
    { grep -v '^XKBOPTIONS=' "$conf"; echo "XKBOPTIONS=${opts:+$opts,}numpad:mac"; } >"$conf.new" &&
        mv "$conf.new" "$conf"
    rm -f "$conf.new"
    return 0
}
EOF
  cat >"$numpad_install" <<'EOF'
#!/bin/bash
# Installed by the Boot & Wake Omarchy plugin; turn it off in its panel.

build() {
    add_runscript
}

help() {
    echo "Makes the number pad type digits at the Plymouth disk password screen."
}
EOF
  cat >"$numpad_conf" <<'EOF'
# Installed by the Boot & Wake Omarchy plugin; turn it off in its panel.
# Runs the boot-wake-numpad hook just before Plymouth, so the number pad types
# digits at the disk password screen. Does nothing if the hook files are gone.
if [[ -f /etc/initcpio/hooks/boot-wake-numpad && -f /etc/initcpio/install/boot-wake-numpad &&
  " ${HOOKS[*]} " != *" boot-wake-numpad "* ]]; then
  _bw_hooks=()
  for _bw_hook in "${HOOKS[@]}"; do
    [[ $_bw_hook == plymouth ]] && _bw_hooks+=(boot-wake-numpad)
    _bw_hooks+=("$_bw_hook")
  done
  HOOKS=("${_bw_hooks[@]}")
  unset _bw_hooks _bw_hook
fi
EOF
  chmod 0644 "$numpad_hook" "$numpad_install" "$numpad_conf"
}

remove_numpad_files() {
  rm -f "$numpad_hook" "$numpad_install" "$numpad_conf"
}

# Builds a throwaway startup image first and checks the hook made it in.
# limine-mkinitcpio reports success even when mkinitcpio fails, so its exit
# code alone can't be trusted.
check_build() {
  local kver tmp ok=1
  kver=$(uname -r)
  [[ -d /usr/lib/modules/$kver ]] || kver=$(ls /usr/lib/modules | sort -V | tail -n1)
  tmp=$(mktemp -d)
  echo "Checking the new startup image..." >&2
  if mkinitcpio -k "$kver" -d "$tmp" >/dev/null 2>&1 &&
    [[ -f $tmp/hooks/boot-wake-numpad ]] && grep -q 'boot-wake-numpad' "$tmp/config"; then
    ok=0
  fi
  rm -rf "$tmp"
  return $ok
}

# Rebuilds the startup image the way Omarchy does.
rebuild_initramfs() {
  echo "Rebuilding the startup image (up to a minute)..." >&2
  limine-mkinitcpio >&2
}

numpad_on() {
  local hooks
  command -v limine-mkinitcpio >/dev/null ||
    { echo "limine-mkinitcpio not found, so the startup image can't be rebuilt. Nothing changed." >&2; exit 1; }
  hooks=$(initramfs_hooks)
  [[ $hooks == *" plymouth "* ]] ||
    { echo "There is no Plymouth password screen to change. Nothing changed." >&2; exit 1; }
  [[ $hooks != *" systemd "* ]] ||
    { echo "A systemd-based startup image is not supported. Nothing changed." >&2; exit 1; }
  [[ -n $(vconsole_layout) ]] ||
    { echo "No keyboard layout is set for the password screen. Nothing changed." >&2; exit 1; }
  [[ -f $numpad_conf ]] && { echo "Number pad already on" >&2; exit 0; }

  snapshot "turning on the number pad at the password screen"
  write_numpad_files
  if ! check_build; then
    remove_numpad_files
    echo "The new startup image did not build, so nothing changed." >&2
    exit 1
  fi
  if ! rebuild_initramfs; then
    # Back to exactly how it was, image included.
    remove_numpad_files
    rebuild_initramfs || true
    echo "The startup image did not rebuild, so the change was undone." >&2
    exit 1
  fi
}

numpad_off() {
  [[ -f $numpad_conf || -f $numpad_hook || -f $numpad_install ]] ||
    { echo "Number pad already off" >&2; exit 0; }
  snapshot "turning off the number pad at the password screen"
  remove_numpad_files
  rebuild_initramfs || { echo "The startup image did not rebuild. Try again." >&2; exit 1; }
}

case ${1:-} in
  boot-menu-set) set_menu "${2:-}" ;;
  boot-menu-restore) restore_menu ;;
  numpad-on) numpad_on ;;
  numpad-off) numpad_off ;;
  *) echo "usage: boot-wake-root boot-menu-set <seconds> | boot-menu-restore | numpad-on | numpad-off" >&2; exit 2 ;;
esac
