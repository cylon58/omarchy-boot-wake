#!/bin/bash

# Stands in for omarchy-system-sleep-monitor while "No second password after
# hibernate" is on. Same delay inhibitor, same lock script. The one change: a
# plain hibernate behind disk encryption skips the lock, because waking up
# already demands the disk password. Suspend, hybrid sleep, suspend-then-
# hibernate and anything unrecognised still lock exactly as before.
#
# Unlike the stock monitor, this one stays running across sleeps. It drops
# the inhibitor to let a sleep proceed, takes it back the moment the machine
# returns, and if a skipped hibernate never actually powered down, it locks
# right then through the same lock script.

here=$(dirname "$(readlink -f "$0")")
# shellcheck source=../lib/common.sh
source "$here/../lib/common.sh"

sleep_lock="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-system-sleep-lock"
[[ -x $sleep_lock ]] || sleep_lock=omarchy-system-sleep-lock

now_ms() { echo $((10#${EPOCHREALTIME//[!0-9]/} / 1000)); }

# The lock script's own budget, worked out the same way it does: logind's
# delay window less a fifth (at least a second), capped at 12s. Time spent
# here deciding comes out of it, so the total never overruns the window.
lock_budget_ms() {
  local window
  window=$(timeout 1 busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null)
  window=${window##* }
  [[ $window =~ ^[0-9]+$ ]] && (( window > 0 )) || window=5000000
  window=$((window / 1000))
  window=$((window - (window / 5 > 1000 ? window / 5 : 1000)))
  (( window < 12000 )) && echo "$window" || echo 12000
}

inhibitor_pid=""

take_inhibitor() {
  [[ -n $inhibitor_pid ]] && return
  systemd-inhibit --what=sleep --mode=delay --who=Omarchy \
    --why="Lock screen before suspend" sleep infinity &
  inhibitor_pid=$!
}

# Ending the held command lets systemd-inhibit exit cleanly and release.
release_inhibitor() {
  [[ -n $inhibitor_pid ]] || return
  pkill -P "$inhibitor_pid" -x sleep 2>/dev/null
  kill "$inhibitor_pid" 2>/dev/null
  wait "$inhibitor_pid" 2>/dev/null
  inhibitor_pid=""
}

trap release_inhibitor EXIT

coproc SLEEP_EVENTS {
  exec dbus-monitor --system \
    "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"
}

take_inhibitor
cursor=$(bw_journal_cursor)
skipped=false
slept_before=""

# Decides whether the sleep announced at $1 (epoch microseconds) may skip the
# lock. The safety check runs every time: a resume boots whatever initramfs
# and sleep settings are on disk now, not what was there at login.
may_skip_lock() {
  [[ $(bw_pending_sleep_action "$cursor" "$1") == hibernate ]] &&
    [[ -z $(bw_hibernate_unprotected_reason) ]] &&
    slept_before=$(bw_slept_seconds) && [[ $slept_before =~ ^[0-9]+$ ]]
}

while true; do
  # Wake every few seconds to make sure the inhibitor is still held. Without
  # it the next suspend would not wait for the lock, so let systemd restart
  # the whole service instead of carrying on unprotected.
  IFS= read -r -t 5 line <&"${SLEEP_EVENTS[0]}"
  status=$?
  if (( status != 0 )); then
    # Above 128 is the read timing out; anything else means dbus-monitor ended.
    (( status > 128 )) || break
    [[ -z $inhibitor_pid ]] || kill -0 "$inhibitor_pid" 2>/dev/null || exit 1
    continue
  fi

  case $line in
    *"boolean true"*)
      started=$(now_ms)
      if may_skip_lock "${EPOCHREALTIME//[!0-9]/}"; then
        skipped=true
      else
        remaining=$(( $(lock_budget_ms) - ($(now_ms) - started) ))
        (( remaining >= 500 )) || remaining=500
        "$sleep_lock" "$remaining"
      fi
      release_inhibitor
      ;;
    *"boolean false"*)
      take_inhibitor
      if $skipped; then
        skipped=false
        # Lock now unless logind confirms a hibernate finished and the machine
        # really spent time powered down. Either missing means the session
        # never left, or did something other than hibernate.
        slept_after=$(bw_slept_seconds)
        if ! bw_hibernate_finished_since "$cursor" ||
          [[ ! $slept_after =~ ^[0-9]+$ ]] || (( slept_after - slept_before < 10 )); then
          "$sleep_lock"
        fi
      fi
      cursor=$(bw_journal_cursor)
      ;;
  esac
done

# dbus-monitor went away; exit so systemd restarts the service cleanly.
exit 1
